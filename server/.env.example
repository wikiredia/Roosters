# Kopieer naar .env (`./roosters.sh init` doet dat en vult de geheimen zelf in).
# .env komt NOOIT in git: hier staan je IP en alle sleutels.

# Je vaste publieke IP. Wordt gebruikt voor het certificaat en de links in de app.
PUBLIC_IP=
# Hostnaam waarop de app bereikbaar is (bij een kaal IP: hetzelfde als PUBLIC_IP)
PUBLIC_HOST=

# letsencrypt = echt certificaat voor je IP (aanrader)
# selfsigned  = https met eigen certificaat (enkel om te testen, geeft waarschuwingen)
# off         = gewoon http (geen locatie, geen pushmeldingen)
# proxy       = achter Caddy van Roosters+ (temp.roostersplus.be): Caddy doet https, zie README
TLS_MODE=letsencrypt
# Start ook de certbot-container (laat leeg bij TLS_MODE=selfsigned, off of proxy)
COMPOSE_PROFILES=letsencrypt
# Optioneel: e-mail voor Let's Encrypt-meldingen. LE_STAGING=1 om eerst te testen.
LE_EMAIL=
LE_STAGING=

# Geheimen: worden door `./roosters.sh init` gegenereerd
DB_PASSWORD=
DB_ROOT_PASSWORD=
SECRET_KEY=
