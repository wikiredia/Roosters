# Copy to .env (never commit .env). Fine as-is on your laptop; on the server every secret must be new:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# dev: API docs, debug endpoints and login codes in the worker log. Use ENV=prod on a real server.
ENV=dev

DB_PASSWORD=dev-db-password
DB_ROOT_PASSWORD=dev-root-password
# At least 32 characters. Changing it later logs everyone out and makes saved calendar links unreadable.
SECRET_KEY=dev-secret-key-change-me-on-the-server-0123456789

# Port of the API on this machine (8000 in use by something else? pick e.g. 8010)
API_PORT=8000

# Where the API is reachable (used in invite links)
PUBLIC_URL=http://localhost:8000

# The web build of the app (expo start --web) runs on another port: allow it on the laptop only
CORS_ORIGINS=*

# Mail: smtp (Mailpit on the laptop) or console (only in the logs)
MAIL_MODE=smtp
MAIL_FROM=Roosters+ <no-reply@localhost>

# Push: expo (Expo's push service, no account needed) or console (only in the logs)
PUSH_MODE=expo
# Only once "enhanced push security" is on in the Expo dashboard
EXPO_ACCESS_TOKEN=

# Sign in with Apple/Google: fill in once the app ids exist (comma-separated)
APPLE_CLIENT_IDS=
# Google: the WEB OAuth client id (xxx.apps.googleusercontent.com), the same one the app has as
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID: it is the audience of every ID token, on Android and iOS
GOOGLE_CLIENT_IDS=

# Management console (Smart-Room console → Roosters+ tab). The console sends these to the admin API
# (127.0.0.1:8090) and the docs service (127.0.0.1:8095). At least 32 characters each; both services
# only listen on this machine. Empty = the admin API refuses everything / the docs are read-only.
ADMIN_TOKEN=dev-admin-token-change-me-on-the-server-0123456789
DOCS_TOKEN=dev-docs-token-change-me-on-the-server-0123456789
