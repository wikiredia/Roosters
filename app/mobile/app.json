{
  "expo": {
    "name": "Roosters+",
    "slug": "roostersplus",
    "scheme": "roostersplus",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F3EF",
    "ios": {
      "bundleIdentifier": "be.roostersplus.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "be.roostersplus.app",
      "adaptiveIcon": {
        "backgroundColor": "#161F2A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2E5BFF",
          "defaultChannel": "requests"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Roosters+ gebruikt je camera om de QR-code van een vriend te scannen.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Roosters+ gebruikt je foto's als je een profielfoto kiest.",
          "cameraPermission": "Roosters+ gebruikt je camera om een profielfoto te maken.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F4F3EF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#161F2A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bae66bdf-da2d-4a71-b514-0ff995d1c195"
      }
    },
    "owner": "wikiredia"
  }
}
